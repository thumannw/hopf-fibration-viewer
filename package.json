{
  "name": "hopf-explorer",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "description": "An offline, portable explorer of the stereographically projected Hopf fibration",
  "packageManager": "pnpm@12.5.1",
  "engines": { "node": ">=24" },
  "scripts": {
    "build": "node scripts/build.mjs",
    "test": "node --test tests/*.test.js",
    "test:browser": "node scripts/browser-check.mjs",
    "test:animation": "node scripts/animation-check.mjs",
    "browsers:install": "playwright install --only-shell chromium"
  },
  "dependencies": { "three": "0.180.0" },
  "devDependencies": { "esbuild": "0.25.10", "playwright": "1.62.1" }
}
